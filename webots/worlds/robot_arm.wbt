#VRML_SIM R2025a utf8

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/R2025a/projects/objects/backgrounds/protos/TexturedBackgroundLight.proto"

# Arm geometry exported from the Fusion model (webots/meshes/*.stl, millimetres, Z up).
# Every mesh sits in a Transform with scale 0.001 and is offset by minus its joint
# origin so the STL world coordinates line up with the hinge anchors below.
#
# Joint heights (m): base yaw 0.0665, shoulder 0.0875, elbow 0.2055, gripper x 0.110.
# Neutral pose (all joints 0 = servo 90 deg): upper arm vertical, forearm horizontal.

WorldInfo {
}
Viewpoint {
  orientation 0.826125 0.342192 0.447685 1.493165
  position 0.65 -0.65 0.50
}
TexturedBackground {
}
TexturedBackgroundLight {
}
Solid {
  translation 0 0 -0.025
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.45 0.45 0.45
        roughness 0.8
        metalness 0
      }
      geometry Box {
        size 1 1 0.05
      }
    }
  ]
  name "work surface"
  boundingObject Box {
    size 1 1 0.05
  }
  locked TRUE
}
Robot {
  children [
    Transform {
      scale 0.001 0.001 0.001
      children [
        Shape {
          appearance DEF WHITE_APPEARANCE PBRAppearance {
            baseColor 0.9 0.9 0.92
            roughness 0.6
            metalness 0
          }
          geometry Mesh {
            url [
              "../meshes/base_plate.stl"
            ]
          }
        }
        Shape {
          appearance DEF SERVO_APPEARANCE PBRAppearance {
            baseColor 0.05 0.05 0.06
            roughness 0.4
            metalness 0.1
          }
          geometry Mesh {
            url [
              "../meshes/servo_base.stl"
            ]
          }
        }
      ]
    }
    HingeJoint {
      jointParameters HingeJointParameters {
        axis 0 0 1
        anchor 0 0 0.0665
        minStop -1.22173
        maxStop 1.22173
        dampingConstant 0.1
      }
      device [
        RotationalMotor {
          name "base_motor"
          maxVelocity 2
          minPosition -1.22173
          maxPosition 1.22173
          maxTorque 3
        }
        PositionSensor {
          name "base_sensor"
        }
      ]
      endPoint Solid {
        translation 0 0 0.0665
        children [
          Transform {
            translation 0 0 -0.0665
            scale 0.001 0.001 0.001
            children [
              Shape {
                appearance USE WHITE_APPEARANCE
                geometry Mesh {
                  url [
                    "../meshes/turntable.stl"
                  ]
                }
              }
              Shape {
                appearance USE SERVO_APPEARANCE
                geometry Mesh {
                  url [
                    "../meshes/servo_shoulder.stl"
                  ]
                }
              }
            ]
          }
          HingeJoint {
            jointParameters HingeJointParameters {
              axis 0 1 0
              anchor 0 0 0.021
              minStop -1.0472
              maxStop 1.0472
              dampingConstant 0.1
            }
            device [
              RotationalMotor {
                name "shoulder_motor"
                maxVelocity 2
                minPosition -1.0472
                maxPosition 1.0472
                maxTorque 3
              }
              PositionSensor {
                name "shoulder_sensor"
              }
            ]
            endPoint Solid {
              translation 0 0 0.021
              children [
                Transform {
                  translation 0 0 -0.0875
                  scale 0.001 0.001 0.001
                  children [
                    Shape {
                      appearance DEF ARM_APPEARANCE PBRAppearance {
                        baseColor 0.75 0.1 0.1
                        roughness 0.35
                        metalness 0
                      }
                      geometry Mesh {
                        url [
                          "../meshes/upper_arm.stl"
                        ]
                      }
                    }
                    Shape {
                      appearance USE SERVO_APPEARANCE
                      geometry Mesh {
                        url [
                          "../meshes/servo_elbow.stl"
                        ]
                      }
                    }
                  ]
                }
                HingeJoint {
                  jointParameters HingeJointParameters {
                    axis 0 1 0
                    anchor 0 0 0.118
                    minStop -1.0472
                    maxStop 1.0472
                    dampingConstant 0.08
                  }
                  device [
                    RotationalMotor {
                      name "elbow_motor"
                      maxVelocity 2
                      minPosition -1.0472
                      maxPosition 1.0472
                      maxTorque 2
                    }
                    PositionSensor {
                      name "elbow_sensor"
                    }
                  ]
                  endPoint Solid {
                    translation 0 0 0.118
                    children [
                      Transform {
                        translation 0 0 -0.2055
                        scale 0.001 0.001 0.001
                        children [
                          Shape {
                            appearance USE ARM_APPEARANCE
                            geometry Mesh {
                              url [
                                "../meshes/forearm.stl"
                              ]
                            }
                          }
                          Shape {
                            appearance USE SERVO_APPEARANCE
                            geometry Mesh {
                              url [
                                "../meshes/servo_gripper.stl"
                              ]
                            }
                          }
                        ]
                      }
                      HingeJoint {
                        jointParameters HingeJointParameters {
                          axis 0 1 0
                          anchor 0.11 0 0
                          minStop 0
                          maxStop 0.610865
                          dampingConstant 0.04
                        }
                        device [
                          RotationalMotor {
                            name "gripper_motor"
                            maxVelocity 3
                            minPosition 0
                            maxPosition 0.610865
                            maxTorque 0.5
                          }
                          PositionSensor {
                            name "gripper_sensor"
                          }
                        ]
                        endPoint Solid {
                          translation 0.11 0 0
                          children [
                            Transform {
                              translation -0.11 0 -0.2055
                              scale 0.001 0.001 0.001
                              children [
                                Shape {
                                  appearance USE ARM_APPEARANCE
                                  geometry Mesh {
                                    url [
                                      "../meshes/finger.stl"
                                    ]
                                  }
                                }
                              ]
                            }
                          ]
                          name "moving gripper finger"
                          boundingObject Group {
                            children [
                              Pose {
                                translation 0.0215 0.08315 0
                                children [
                                  Box {
                                    size 0.067 0.005 0.016
                                  }
                                ]
                              }
                              Pose {
                                translation 0.051 0.08315 -0.0155
                                children [
                                  Box {
                                    size 0.014 0.005 0.047
                                  }
                                ]
                              }
                            ]
                          }
                          physics Physics {
                            density -1
                            mass 0.08
                          }
                        }
                      }
                    ]
                    name "forearm"
                    boundingObject Group {
                      children [
                        Pose {
                          translation 0.055 0.0548 0
                          children [
                            Box {
                              size 0.138 0.0507 0.028
                            }
                          ]
                        }
                        Pose {
                          translation 0.109 0.08165 -0.0275
                          children [
                            Box {
                              size 0.008 0.008 0.029
                            }
                          ]
                        }
                      ]
                    }
                    physics Physics {
                      density -1
                      mass 0.2
                    }
                  }
                }
              ]
              name "upper arm"
              boundingObject Pose {
                translation 0 -0.0001 0.059
                children [
                  Box {
                    size 0.028 0.0593 0.146
                  }
                ]
              }
              physics Physics {
                density -1
                mass 0.3
              }
            }
          }
        ]
        name "base turret"
        boundingObject Group {
          children [
            Pose {
              translation 0 0 0.003
              children [
                Cylinder {
                  height 0.006
                  radius 0.05
                }
              ]
            }
            Pose {
              translation -0.01025 0 0.0174
              children [
                Box {
                  size 0.0605 0.0495 0.0268
                }
              ]
            }
          ]
        }
        physics Physics {
          density -1
          mass 0.25
        }
      }
    }
  ]
  name "workshop robot arm"
  boundingObject Pose {
    translation 0 0 0.024
    children [
      Cylinder {
        height 0.048
        radius 0.065
      }
    ]
  }
  locked TRUE
  controller "arm_controller"
  selfCollision TRUE
}
